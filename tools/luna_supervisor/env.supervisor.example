# Luna Agent Supervisor - Configuration locale non versionnée
# Copier ce fichier en /home/ludo/luna-server/.env.supervisor et renseigner les secrets.

# --- n8n ---
N8N_HEADER_NAME=X-Luna-Runner-Key
N8N_HEADER_VALUE=remplacer_par_la_valeur_secrete
N8N_NEXT_JOB_URL=https://ludo971.app.n8n.cloud/webhook/luna-runner-next-job
N8N_REPORT_URL=https://ludo971.app.n8n.cloud/webhook/luna-runner-report

# --- Identité ---
RUNNER_ID=luna-vm-01
PROJECT_PATH=/home/ludo/luna-server

# --- Android ---
ANDROID_PACKAGE=fr.yawatch.luna
ANDROID_MAIN_ACTIVITY=fr.yawatch.luna.MainActivity
ANDROID_DEVICE_ID=192.168.1.62:43805

# --- Cycle ---
POLL_INTERVAL_SECONDS=1800
MAX_ITERATIONS=3
LOG_LEVEL=INFO

# --- Budget ---
MAX_AI_CALLS_PER_DAY=8
MAX_KIMI_CALLS_PER_DAY=5
MAX_DEEPSEEK_CALLS_PER_DAY=1
MAX_CODEX_CALLS_PER_DAY=2
MAX_REVIEW_CALLS_PER_DAY=2
MAX_CALLS_PER_MISSION=12
MAX_SAME_ERROR_ATTEMPTS=2
MAX_CONTEXT_CHARACTERS=60000
MAX_LOG_LINES_FOR_AI=250

# --- Agents (optionnels) ---
# DEEPSEEK_API_KEY=sk-...
# OPENAI_API_KEY=sk-...
