# =============================================================================
# Configuration YAWatch Luna - Template pour nouvel exploitant
# Copier ce fichier en .env et remplir les valeurs
# =============================================================================

# --- OpenAI (OBLIGATOIRE - le serveur ne demarre pas sans) ---
OPENAI_API_KEY=sk-proj-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
OPENAI_MODEL=gpt-4-turbo

# --- Auth / JWT (OBLIGATOIRE - le serveur ne demarre pas sans) ---
JWT_SECRET_KEY=change-me-to-a-very-long-random-secret-min-32-characters

# --- Twilio SMS (OBLIGATOIRE pour l'envoi de SMS) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_SMS_FROM=+1XXXXXXXXXX

# --- Tavus Video Avatar (OBLIGATOIRE pour les appels video) ---
TAVUS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TAVUS_LUNA_PERSONA_ID=pXXXXXXXXXXX
TAVUS_CALLBACK_URL=https://VOTRE_DOMAINE:8888/api/webhook/tavus

# --- Redis (OBLIGATOIRE - memoire persistante) ---
REDIS_URL=redis://localhost:6379/0

# --- Contact Admin (OBLIGATOIRE - numero du proprietaire/admin) ---
ADMIN_NUMBER=+33XXXXXXXXX

# --- Amadeus - Vols et Hotels (OPTIONNEL - conciergerie voyage) ---
# Creez un compte sur https://developers.amadeus.com (gratuit en mode test)
# AMADEUS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# AMADEUS_API_SECRET=xxxxxxxxxxxxxxxx
# AMADEUS_ENV=test  # "test" ou "production"

# --- TheFork - Restaurants (OPTIONNEL - reservation restaurants) ---
# Programme partenaire TheFork
# THEFORK_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# THEFORK_ENV=test  # "test" ou "production"

# --- CORS (optionnel - origines autorisees, separer par virgule) ---
# CORS_ORIGINS=https://localhost:8888,https://mondomaine.com

# --- Protection fondateur (IPs jamais bannies par Cortex) ---
# Mettre votre IPv4 fixe et/ou le prefixe /64 de votre box IPv6
# FOUNDER_IPS=203.0.113.1
# FOUNDER_IP_PREFIXES=2001:db8:1234:5678:

# --- Mode Test Fondateur (NE PAS ACTIVER EN PRODUCTION) ---
# FOUNDATION_TEST_MODE=true  # true = aucun appel externe reel (SMS, email, appels, reservations, paiements)
# ALLOW_TEST_EXTERNAL=false  # Surcharge dangereuse pour forcer les appels externes meme en test. GARDER false.

# --- Coupe-circuit SMS urgence ---
# Mettre a false en DEV/staging pour bloquer les SMS d'urgence (Guardian, SOS, alertes contacts urgence)
# sans affecter les autres SMS (invitations, OTP, comptes-rendus d'appel...)
# GUARDIAN_SMS_ENABLED=true
# Appel vocal Guardian — desactive par defaut, activation explicite en PROD uniquement
# GUARDIAN_CALL_ENABLED=false

# --- Stripe (paiements) ---
# STRIPE_API_KEY=<VOTRE_CLE_LIVE_STRIPE>
# STRIPE_TEST_SECRET_KEY=<VOTRE_CLE_TEST_STRIPE>

# --- Compte fondateur (OBLIGATOIRE - acces super-admin initial) ---
PROPRIO_EMAIL=admin@example.com
# Mot de passe en CLAIR (deprecated - utilisez PROPRIO_PASSWORD_HASH)
# PROPRIO_PASSWORD=change-me-strong-password
# Hash bcrypt du mot de passe fondateur (recommande)
# Genere avec: python3 -c "import bcrypt; print(bcrypt.hashpw(b'votre_mot_de_passe', bcrypt.gensalt(rounds=12)).decode())"
PROPRIO_PASSWORD_HASH=$2b$12$XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
